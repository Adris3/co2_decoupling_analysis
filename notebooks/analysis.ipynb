    "global_trend = (\n",
    "    emissions_df.groupby(\"year\", as_index=False)\n",
    "    .agg(\n",
    "        co2=(\"co2\", \"sum\"),\n",
    "        countries=(\"iso_code\", \"nunique\"),\n",
    "    )\n",
    "    .sort_values(\"year\")\n",
    ")\n",
    "\n",
    "display(global_trend.tail())\n",
    "\n",
    "fig, ax = plt.subplots(figsize=(10, 5))\n",
    "ax.plot(global_trend[\"year\"], global_trend[\"co2\"], marker=\".\")\n",
    "ax.set(\n",
    "    title=\"Global CO₂ emissions by year\",\n",
    "    xlabel=\"Year\",\n",
    "    ylabel=\"CO₂ emissions (million tonnes)\",\n",
    ")\n",
    "ax.grid(True, alpha=0.3)\n",
    "plt.tight_layout()\n",
    "plt.show()\n",
    "\n",
    "from config import BASE_YEAR, END_YEAR, FIGURES_DIR\n",
    "\n",
    "changes = label_decoupling(compute_changes(emissions_df))\n",
    "top_decoupling_results = top_decouplers(changes, n=10)\n",
    "ttest_results = run_ttest(changes)\n",
    "FIGURES_DIR.mkdir(parents=True, exist_ok=True)\n",
    "\n",
    "print(f\"Comparison period: {BASE_YEAR}-{END_YEAR}\")\n",
    "print(f\"Countries with complete endpoint data: {len(changes)}\")\n",
    "print(f\"Countries with GDP growth and falling CO₂: {changes['decoupled'].sum()}\")\n",
    "print(\"\\nTop decouplers by CO₂ percentage reduction:\")\n",
    "print(top_decoupling_results.to_string(index=False))\n",
    "print(\"\\nWelch's t-test on CO₂-intensity percentage change:\")\n",
    "for key, value in ttest_results.items():\n",
    "    print(f\"{key}: {value:.4g}\" if isinstance(value, float) else f\"{key}: {value}\")\n",
    "\n",
    "fig, ax = plt.subplots(figsize=(9, 6))\n",
    "other = changes.loc[~changes[\"decoupled\"]]\n",
    "decoupled = changes.loc[changes[\"decoupled\"]]\n",
    "ax.scatter(other[\"gdp_pct_change\"], other[\"co2_pct_change\"], label=\"Not decoupled\", alpha=0.7)\n",
    "ax.scatter(decoupled[\"gdp_pct_change\"], decoupled[\"co2_pct_change\"], label=\"Decoupled\", alpha=0.85)\n",
    "ax.axhline(0, color=\"gray\", linewidth=1)\n",
    "ax.axvline(0, color=\"gray\", linewidth=1)\n",
    "ax.set(title=f\"GDP and CO₂ changes, {BASE_YEAR}-{END_YEAR}\", xlabel=\"GDP change (%)\", ylabel=\"CO₂ change (%)\")\n",
    "ax.legend()\n",
    "ax.grid(True, alpha=0.25)\n",
    "fig.tight_layout()\n",
    "fig.savefig(FIGURES_DIR / \"decoupling_scatter.png\", dpi=150, bbox_inches=\"tight\")\n",
    "plt.show()\n",
    "plt.close(fig)\n",
    "\n",
    "decoupler_cases = decoupled.nsmallest(3, \"co2_pct_change\")[\"country\"].tolist()\n",
    "other_cases = other.nlargest(3, \"co2_pct_change\")[\"country\"].tolist()\n",
    "case_countries = decoupler_cases + other_cases\n",
    "print(\"Line-chart case studies (first group decoupled, second group not decoupled):\")\n",
    "print(case_countries)\n",
    "case_data = emissions_df.loc[\n",
    "    emissions_df[\"country\"].isin(case_countries)\n",
    "    & emissions_df[\"year\"].between(BASE_YEAR, END_YEAR)\n",
    "].sort_values(\"year\")\n",
    "fig, ax = plt.subplots(figsize=(10, 6))\n",
    "for country in case_countries:\n",
    "    country_data = case_data.loc[case_data[\"country\"] == country]\n",
    "    ax.plot(country_data[\"year\"], country_data[\"co2\"], marker=\".\", label=country)\n",
    "ax.set(title=f\"Annual CO₂ emissions in selected countries, {BASE_YEAR}-{END_YEAR}\", xlabel=\"Year\", ylabel=\"CO₂ emissions (million tonnes)\")\n",
    "ax.legend(ncol=2)\n",
    "ax.grid(True, alpha=0.25)\n",
    "fig.tight_layout()\n",
    "fig.savefig(FIGURES_DIR / \"decoupling_case_studies.png\", dpi=150, bbox_inches=\"tight\")\n",
    "plt.show()\n",
    "plt.close(fig)\n",
    "\n",
    "fig, ax = plt.subplots(figsize=(9, 6))\n",
    "if top_decoupling_results.empty:\n",
    "    ax.text(0.5, 0.5, \"No countries met the decoupling definition\", ha=\"center\", va=\"center\")\n",
    "    ax.set_axis_off()\n",
    "else:\n",
    "    ax.barh(top_decoupling_results[\"country\"], -top_decoupling_results[\"co2_pct_change\"])\n",
    "    ax.invert_yaxis()\n",
    "    ax.set_xlabel(\"CO₂ reduction (%)\")\n",
    "    ax.grid(axis=\"x\", alpha=0.25)\n",
    "ax.set_title(f\"Top 10 decouplers by CO₂ reduction, {BASE_YEAR}-{END_YEAR}\")\n",
    "fig.tight_layout()\n",
    "fig.savefig(FIGURES_DIR / \"top_decouplers.png\", dpi=150, bbox_inches=\"tight\")\n",
    "plt.show()\n",
    "plt.close(fig)"
   ]
